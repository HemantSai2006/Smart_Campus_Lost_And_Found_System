# ========================================================
# Smart Campus Lost & Found Management System - .gitignore
# ========================================================

# Compiled Java & Maven Artifacts
**/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Node & Frontend (Vite / React)
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local
.eslintcache

# Environment Variables & Credentials
.env
.env.*
!.env.example

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# User Uploaded Files (preserve directory structure only)
uploads/*
!uploads/.gitkeep

# IDEs & Code Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Python / Testing Scratch
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
test_*.py
test_*.json
find_mvn.py
inspect_items.py
restart_and_verify.py
